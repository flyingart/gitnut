# Copy to .env (gitignored) on every machine that builds releases, or run `bun run setup`.

# Website of your releases. Baked into every binary: updates come from <site>/manifest.json.
GITNUT_SITE_URL=https://gitnut.dev

# Desktop updater key (desktop builds only). Keep a copy in your password manager.
TAURI_SIGNING_PRIVATE_KEY=/path/to/gitnut.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS (optional): picked from the Keychain when unset.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# GITNUT_NOTARY_PROFILE=gitnut-notary
