{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitNut",
  "mainBinaryName": "gitnut-desktop",
  "version": "0.1.0",
  "identifier": "dev.gitnut",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitNut",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#07060b",
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Remote-first git client",
    "longDescription": "GitNut shows the git state of many repositories on many machines, with an IntelliJ-style log graph and diff viewer.",
    "copyright": "Copyright Flying Art. Apache-2.0.",
    "publisher": "Flying Art",
    "homepage": "https://gitnut.dev",
    "externalBin": [
      "binaries/gitnut"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
